<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(TargetFramework)</TargetFramework>
	  <Copyright>$(Copyright)</Copyright>
	  <Company>$(Company)</Company>
	  <Authors>$(Authors)</Authors>
	  <Version>1.0.1</Version>
	  <Description>The $(RootNamespace) entity mongodb(nosql).</Description>
	  <PackageId>$(RootNamespace)</PackageId>
	  <PackageTags>Maggsoft,$(RootNamespace)</PackageTags>
	  <PackageLicenseExpression>$(PackageLicenseExpression)</PackageLicenseExpression>
	  <PackageProjectUrl>$(PackageProjectUrl)</PackageProjectUrl>
	  <RepositoryUrl>$(RepositoryUrl)</RepositoryUrl>
	  <RepositoryType>$(RepositoryType)</RepositoryType>
	  <PackageIconUrl>$(PackageIconUrl)</PackageIconUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Bson" Version="$(MongoDBBsonVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maggsoft.Data\Maggsoft.Data.csproj" />
  </ItemGroup>

</Project>
