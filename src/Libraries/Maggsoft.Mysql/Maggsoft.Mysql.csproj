<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(TargetFramework)</TargetFramework>
        <Nullable>enable</Nullable>
        <Copyright>$(Copyright)</Copyright>
        <Company>$(Company)</Company>
        <Authors>$(Authors)</Authors>
        <Version>1.0.0</Version>
        <Description>The Maggsoft.Mysql project contains a set of core classes for maggsoft, such as caching, events, helpers, and business objects (for example, Order and Customer entities).</Description>
        <PackageLicenseUrl>$(PackageLicenseUrl)</PackageLicenseUrl>
        <PackageProjectUrl>$(PackageProjectUrl)</PackageProjectUrl>
        <RepositoryUrl>$(RepositoryUrl)</RepositoryUrl>
        <PackageIconUrl>$(PackageIconUrl)</PackageIconUrl>
        <RepositoryType>$(RepositoryType)</RepositoryType>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="AspectCore.Abstractions" />
        <PackageReference Include="FluentMigrator"/>
        <PackageReference Include="FluentMigrator.Runner"/>
        <PackageReference Include="FluentMigrator.Runner.MySql"/>

        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"  />
        <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\Data\Maggsoft.Data.Mysql\Maggsoft.Data.Mysql.csproj" />
      <ProjectReference Include="..\Maggsoft.Core\Maggsoft.Core.csproj" />
    </ItemGroup>

</Project>
